# Copy to .env (`cp .env.example .env`). Values here are for LOCAL DEVELOPMENT
# ONLY. Never reuse them anywhere reachable from a network you do not control.

# --- PostgreSQL ---
POSTGRES_USER=latex_cloud
POSTGRES_PASSWORD=latex_cloud_dev_only
POSTGRES_DB=latex_cloud
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Object storage (MinIO locally, S3 in AWS) ---
MINIO_ROOT_USER=latexcloud
MINIO_ROOT_PASSWORD=latexcloud-dev-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=latex-cloud

# --- API (host-run `pnpm dev`; compose sets container-internal URLs itself) ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://latex_cloud:latex_cloud_dev_only@localhost:5432/latex_cloud
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=latexcloud
S3_SECRET_ACCESS_KEY=latexcloud-dev-only
S3_FORCE_PATH_STYLE=true
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=336

# --- Web ---
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:4000

# --- Dev seed (refused when NODE_ENV=production) ---
SEED_USER_PASSWORD=latex-cloud-dev-password

# --- Compile orchestrator (fixture runner for now) ---
# docker (default) | local-trusted-dev (UNSANDBOXED, trusted documents only)
COMPILE_EXECUTOR=docker
ALLOW_TRUSTED_LOCAL_EXECUTOR=false
TEX_IMAGE=latex-cloud/texlive:dev
DOCKER_RUNTIME=runc
# Required in production; references an independent sandbox security review.
COMPILE_SANDBOX_ATTESTATION=
