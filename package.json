{
  "name": "latex-cloud",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @latex-cloud/api --filter @latex-cloud/web --filter @latex-cloud/collab dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tests/e2e/tsconfig.json",
    "test": "pnpm build:packages && pnpm -r test",
    "test:integration": "pnpm build:packages && pnpm --filter @latex-cloud/api test:integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:migrate": "pnpm build:packages && pnpm --filter @latex-cloud/api db:migrate",
    "db:seed": "pnpm --filter @latex-cloud/api db:seed",
    "fixtures:compile": "pnpm build:packages && pnpm --filter @latex-cloud/compile-orchestrator fixtures",
    "tex-image:build": "docker build -t latex-cloud/texlive:dev infra/tex-images",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d --wait postgres redis storage",
    "stack:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up --build -d --wait --remove-orphans",
    "stack:down": "docker compose -f infra/compose/docker-compose.yml --env-file .env down",
    "dev:setup": "pnpm build:packages && pnpm --filter @latex-cloud/api db:migrate && pnpm --filter @latex-cloud/api db:seed && pnpm --filter @latex-cloud/api storage:init",
    "dev:worker": "pnpm build:packages && pnpm --filter @latex-cloud/compile-orchestrator worker",
    "stack:up:minio": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/storage-minio.yml --env-file .env up --build -d --wait"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
