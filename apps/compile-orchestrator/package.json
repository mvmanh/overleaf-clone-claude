{
  "name": "@latex-cloud/compile-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Compile control plane: runs untrusted TeX only through a SandboxExecutor. Separate process from web/api.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:fixtures": "vitest run --project fixtures",
    "fixtures": "tsx src/fixtures/cli.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker/main.ts",
    "start": "node --enable-source-maps dist/worker/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@latex-cloud/compiler-protocol": "workspace:*",
    "@latex-cloud/shared": "workspace:*",
    "@latex-cloud/tex-log-parser": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "kysely": "0.28.19",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
