#!/bin/sh
# Entry point of the compile sandbox image.
#   stdin : tar of the project snapshot (regular files only)
#   argv  : <root-file> <latexmk args...>
#   stdout: tar of artifacts + exit-status + timings (nothing else!)
# Runs as an unprivileged user with a read-only root fs; /work and /tmp are tmpfs.
set -eu
umask 077

ROOT="$1"
shift

SRC=/work/src
OUT=/work/out
mkdir -p "$SRC" "$OUT"
export HOME=/tmp/home TEXMFVAR=/tmp/texmf-var TEXMFOUTPUT="$OUT"
mkdir -p "$HOME" "$TEXMFVAR"

# Extract input. Refuse absolute names and links; drop anything that is not a
# regular file or directory as a second line of defence.
tar -x -C "$SRC" --no-same-owner --no-same-permissions --no-overwrite-dir -f - 1>&2
find "$SRC" \( -type l -o -type b -o -type c -o -type p -o -type s \) -delete 1>&2

# Optional build cache from this project's previous successful build: move it
# into the output directory so latexmk can skip passes that are up to date.
if [ -d "$SRC/__lc_cache__" ]; then
  cp -R "$SRC/__lc_cache__/." "$OUT/" 1>&2
  rm -rf "$SRC/__lc_cache__"
fi

cd "$SRC"
START=$(date +%s%3N)
set +e
latexmk "$@" >"$OUT/latexmk.stdout" 2>&1
STATUS=$?
set -e
END=$(date +%s%3N)

cd "$OUT"
BASE=$(basename "$ROOT")
BASE=${BASE%.tex}
BASE=${BASE%.ltx}
printf '%s\n' "$STATUS" > exit-status
printf '%s %s\n' "$START" "$END" > timings
# Export reusable intermediates for the next build of this project.
find . -type f \( -name '*.aux' -o -name '*.bbl' -o -name '*.bcf' -o -name '*.blg' -o -name '*.run.xml' \
  -o -name '*.toc' -o -name '*.lof' -o -name '*.lot' -o -name '*.out' -o -name '*.fdb_latexmk' -o -name '*.fls' \
  -o -name '*.nav' -o -name '*.snm' -o -name '*.vrb' -o -name '*.idx' -o -name '*.ind' -o -name '*.ilg' \
  -o -name '*.glo' -o -name '*.gls' -o -name '*.glg' -o -name '*.acn' -o -name '*.acr' -o -name '*.alg' \
  -o -name '*.ist' -o -name '*.xdy' -o -name '*.loa' -o -name '*.mw' \) \
  | sed 's|^\./||' | head -n 2000 > /tmp/cache-list
if [ -s /tmp/cache-list ]; then
  tar -cf /tmp/build-cache.tar -T /tmp/cache-list 2>/dev/null && mv /tmp/build-cache.tar build-cache.tar
fi

set -- exit-status timings latexmk.stdout
for f in "$BASE.pdf" "$BASE.log" "$BASE.synctex.gz" build-cache.tar; do
  [ -f "$f" ] && set -- "$@" "$f"
done
exec tar -c -f - "$@"
