{
  "name": "@latex-cloud/tex-log-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Parses TeX/latexmk .log output into structured diagnostics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@latex-cloud/compiler-protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  }
}
